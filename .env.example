# Copy to .env and set your own values. .env is never committed.
# These are local development credentials for the simulated database only.

# Database name and administrator (owns schemas, roles and the audit trail)
POSTGRES_DB=fjf2026
POSTGRES_USER=fjf_admin
POSTGRES_PASSWORD=change-me

# Role that loads raw data (write access to raw_* schemas, no access to the audit log)
FJF_LOADER_PASSWORD=change-me

# Role that reads raw data and the audit log (no write access anywhere)
FJF_READER_PASSWORD=change-me
