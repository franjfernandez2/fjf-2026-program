# --- R and RStudio ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# --- renv: the lockfile is versioned, the library is not ---
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/

# --- targets: the pipeline store is rebuilt from code ---
_targets/

# --- Generated data: every dataset is rebuilt by the pipeline ---
data/raw/*
# ...except the study raw data, generated once from the sealed seed and committed (ADR 0018).
!data/raw/201/
!data/raw/301/
!data/raw/manifest.csv
# Rehearsals of the generation with public seeds are never committed.
data/rehearsal/
data/sdtm/*
data/adam/*
!data/*/.gitkeep
!data/*/README.md

# --- Third-party data: downloaded and verified by the pipeline, never redistributed (ADR 0015) ---
data/external/*
!data/external/README.md
!data/external/*-manifest.csv

# --- Sealed simulation truth: never committed, never read by analysis code ---
simulator/truth/

# --- Rendered documents ---
.quarto/
*_files/
reports/**/*.html
reports/**/*.pdf

# --- Secrets and local configuration ---
.env
.env.*
!.env.example

# --- Operating system and editors ---
.DS_Store
.vscode/
.idea/

# --- Quarto render output ---
_output/

# --- Benchmark outputs: rebuilt by the pipeline; the rendered report page is CDISC material ---
studies/*/output/

# --- The explorer page is rebuilt by the pipeline ---
app/output/
